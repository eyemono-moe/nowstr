{
  "manifest_version": 3,
  "name": "Nowstr Bridge",
  "version": "0.1.4",
  "description": "YouTube Music で再生中の曲を Nowstr に渡し、Nostr のステータスとして掲示できるようにします。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting"],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://nowstr.eyemono.moe/*",
    "https://127.0.0.1:*/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["youtube-music-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["youtube-music.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://nowstr.eyemono.moe/*",
        "https://127.0.0.1:*/*",
        "http://127.0.0.1:*/*",
        "http://localhost:*/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
