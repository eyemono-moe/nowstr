# Spotify Developer Dashboard で発行した Client ID（必須）
VITE_SPOTIFY_CLIENT_ID=

# 任意: Redirect URI を明示したい場合のみ設定する。
# 省略時は `${location.origin}/`（サイトのトップ）を使う。
# VITE_SPOTIFY_REDIRECT_URI=https://127.0.0.1:5173/

# 任意: 公開する URL。設定すると OGP の og:url / og:image（絶対 URL が必要）を出力する
# VITE_SITE_URL=https://nowstr.example.com

# 任意: フッターとプライバシーポリシーに表示するソースコードの URL
# VITE_SOURCE_URL=https://github.com/eyemono-moe/nowstr

# 任意: プライバシーポリシーに表示する問い合わせ先（URL または mailto:）
# 省略時はソースコードの URL を案内する
# VITE_CONTACT_URL=
